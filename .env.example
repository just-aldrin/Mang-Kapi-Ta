# Copy to .env for local development. On Vercel, add these under Project Settings > Environment Variables.
# Never commit .env.

# --- Database (Supabase: create a NEW project for this shop) ---
SUPABASE_URL=
# Use the service_role key. It stays on the server and must never be exposed in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- GCash via PayMongo ---
# Leave PAYMONGO_SECRET_KEY blank to use the built-in test-mode GCash simulator.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# In production with no PayMongo key, the simulator is OFF unless this is "true" (portfolio demo only).
DEMO_PAYMENTS=

# --- Site ---
# Public URL, e.g. https://mang-kapi-ta.vercel.app (auto-detected on Vercel if blank).
APP_URL=
# Enables the staff page at /admin. Use a long random password.
ADMIN_PASSWORD=
# Optional: separate secret for signing the staff session cookie (falls back to ADMIN_PASSWORD).
SESSION_SECRET=

# Contact details shown on the site (read at build time).
SHOP_PHONE=0917-000-0000
SHOP_EMAIL=events@mangkapita.ph
