# Copy to .env and fill in. Never commit .env.

# Public URL of the site (needed in production so GCash returns customers to the right place).
# APP_URL=https://www.example.com

# GCash via PayMongo. Leave blank to use the built-in test-mode simulator.
# Use a test key (sk_test_...) while developing and a live key (sk_live_...) in production.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Staff page at /admin/ (disabled while blank).
ADMIN_PASSWORD=

SHOP_PHONE=0917-000-0000
SHOP_EMAIL=events@mangkapita.ph
